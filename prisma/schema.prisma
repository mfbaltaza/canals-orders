generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id     String  @id @default(cuid())
  email  String  @unique
  name   String
  orders Order[]
}

model Product {
  id         String      @id @default(cuid())
  sku        String      @unique
  name       String
  priceCents Int
  inventory  Inventory[]
  items      OrderItem[]
}

model Warehouse {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  lat       Float
  lng       Float
  inventory Inventory[]
  orders    Order[]
}

model Inventory {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Int       @default(0) // CHECK (quantity >= 0) lives in the migration SQL
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([productId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
}

model Order {
  id                     String           @id @default(cuid())
  customerId             String
  warehouseId            String
  totalCents             Int
  status                 OrderStatus      @default(PENDING_PAYMENT)
  idempotencyKey         String
  idempotencyRequestHash String
  shippingAddress        Json
  shippingLat            Float
  shippingLng            Float
  paymentReference       String?          @unique
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  customer               Customer         @relation(fields: [customerId], references: [id])
  warehouse              Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items                  OrderItem[]
  paymentAttempts        PaymentAttempt[]

  // Leading customerId column also serves "orders by customer" lookups
  @@unique([customerId, idempotencyKey])
  @@index([warehouseId])
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int // CHECK (quantity > 0) lives in the migration SQL
  unitPriceCents Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  // Leading orderId column also serves "items of an order" lookups
  @@unique([orderId, productId])
  @@index([productId])
}

enum PaymentAttemptStatus {
  PENDING
  APPROVED
  DECLINED
  UNKNOWN
}

model PaymentAttempt {
  id            String               @id @default(cuid())
  orderId       String
  amountCents   Int
  status        PaymentAttemptStatus @default(PENDING)
  declineReason String?
  reference     String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum MockChargeStatus {
  APPROVED
  DECLINED
}

model MockCharge {
  id            String           @id @default(cuid())
  description   String           @unique
  amountCents   Int
  status        MockChargeStatus
  reference     String?          @unique
  declineReason String?
  availableAt   DateTime
  createdAt     DateTime         @default(now())
}
