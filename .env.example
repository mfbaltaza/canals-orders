# Local Postgres from docker-compose.yml (`npm run db:up`).
DATABASE_URL=postgresql://canals:canals@localhost:5432/canals_orders

# Only needed with a pooled host such as Neon: the non-pooled URL, used for migrations.
# DIRECT_URL=

# Optional (defaults shown)
# HOST=127.0.0.1
# PORT=3000
# LOG_LEVEL=info

# Requests per minute per IP on POST /orders. 0 = off.
# Defaults to 10 when NODE_ENV=production, off otherwise (load scripts fire from one IP).
# RATE_LIMIT_MAX=10

# Read the client IP from X-Forwarded-For. Only behind a proxy you trust (Railway's edge).
# Defaults to true when NODE_ENV=production, false otherwise.
# TRUST_PROXY=false

# Browser origins allowed to call the API, comma-separated. Empty = no cross-origin browser calls.
# CORS_ORIGINS=http://localhost:5173,https://canals-orders.example.com

# After this, the charge counts as "unknown" (202) and the order stays pending.
# PAYMENT_TIMEOUT_MS=10000

# Resolves orders stuck in PENDING_PAYMENT. 0 = off (`npm run sweep` runs one pass by hand).
# SWEEP_INTERVAL_MS=60000
# Only orders older than this. Must be at least PAYMENT_TIMEOUT_MS + 60000.
# SWEEP_STALE_AFTER_MS=600000
