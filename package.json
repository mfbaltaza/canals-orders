{
  "name": "canals-orders",
  "version": "1.0.0",
  "description": "Challenge for Canals",
  "license": "ISC",
  "author": "Juan Araujo",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "node --watch index.ts",
    "build": "prisma generate && tsc --noEmit",
    "start": "node index.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma generate",
    "db:studio": "prisma studio",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "concurrency": "node scripts/concurrency.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.3",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
